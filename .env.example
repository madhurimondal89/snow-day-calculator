# ==============================================================================
# WEATHER HUB — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Weather Hub"
NEXT_PUBLIC_SITE_DESCRIPTION="Global real-time weather forecasts, high-resolution radar maps, hourly trends, and 7-day forecasts powered by open meteorological data."

# Commercial Policy Mode
# When SITE_COMMERCIAL=true, providers whose free endpoints prohibit commercial use are automatically skipped
SITE_COMMERCIAL=true

# Provider Enable Flags (Default: true for no-key providers)
METNO_ENABLED=true
METNO_USER_AGENT=WeatherHub/1.0 (https://github.com/weather-hub/weather-hub info@weatherhub-project.org)

NOAA_ENABLED=true
NOAA_USER_AGENT=WeatherHub/1.0 (https://github.com/weather-hub/weather-hub info@weatherhub-project.org)

FMI_ENABLED=true
MSC_GEOMET_ENABLED=true

# Optional Commercial / Freemium API Keys (Leave blank if not using - zero cost default)
WEATHERAPI_ENABLED=true
WEATHERAPI_API_KEY=

WEATHERMETRO_ENABLED=false
WEATHERMETRO_API_KEY=

VISUALCROSSING_ENABLED=true
VISUALCROSSING_API_KEY=

METOFFICE_ENABLED=true
METOFFICE_API_KEY=

# Open-Meteo Configuration (Strictly non-commercial on free public endpoint)
OPENMETEO_ENABLED=false
OPENMETEO_MODE=public # options: 'public', 'self-hosted', 'commercial'
OPENMETEO_BASE_URL=

# Caching Configuration (Time-To-Live in seconds)
WEATHER_CACHE_SECONDS=900
HOURLY_CACHE_SECONDS=900
DAILY_CACHE_SECONDS=1800
GEOCODING_CACHE_SECONDS=86400
AQI_CACHE_SECONDS=1800

# Optional Analytics Integration (plausible, umami, ga4)
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_ANALYTICS_DOMAIN=
